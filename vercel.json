{
  "buildCommand": "node cloud/build.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "headers": [{"source":"/(.*)","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"},
    {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}
  ]}],
  "functions": {"api/index.mjs": {"maxDuration": 300},"api/collect.mjs":{"maxDuration":300,"experimentalTriggers":[{"type":"schedule/v1beta"}]}},
  "schedules": {"instagram-collection":{"schedule":"*/15 * * * *","function":"api/collect"}},
  "rewrites": [
    {"source":"/api/:path*","destination":"/api/index?route=api/:path*"},
    {"source":"/auth/callback","destination":"/api/index?route=auth/callback"},
    {"source":"/oauth/google/callback","destination":"/api/index?route=oauth/google/callback"}
  ]
}
